{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w3ti/Lyrnova/blob/main/docs/plugins/plugin-catalog.schema.json",
  "title": "Lyrnova Authenticated Plugin Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signatures"],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "expiresAt", "publisherKeys", "entries"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "version": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": "integer", "minimum": 1, "description": "Unix timestamp in seconds." },
        "publisherKeys": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/publisherKey" }
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/release" }
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 of the raw 32-byte Ed25519 public key."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "signature": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "publisherKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "algorithm", "keyId", "publicKey", "status"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
        "algorithm": { "const": "ed25519" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "publicKey": { "type": "string", "contentEncoding": "base64" },
        "status": { "enum": ["active", "revoked"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "descriptor", "releaseTag", "publisherSignature"],
      "properties": {
        "manifest": { "$ref": "plugin-manifest.schema.json" },
        "descriptor": { "$ref": "plugin-package-descriptor.schema.json" },
        "releaseTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "publisherSignature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
