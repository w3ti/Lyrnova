{
  "schemaVersion": 1,
  "id": "io.github.w3ti.lyrnova.language.rust",
  "name": "Rust",
  "description": "Rust local: diagnósticos, autocomplete, definição, hover, referências, renomeação, formatação e tarefas Cargo.",
  "version": "0.1.2",
  "publisher": "w3ti",
  "license": "GPL-3.0-only",
  "kind": "language",
  "compatibility": {
    "lyrnova": ">=0.1.0, <0.2.0",
    "pluginApi": 1
  },
  "runtime": {
    "type": "builtin",
    "module": "language.rust"
  },
  "source": {
    "type": "bundled",
    "repository": "https://github.com/w3ti/Lyrnova"
  },
  "capabilities": [
    "syntax_highlighting",
    "autocomplete",
    "snippets",
    "templates",
    "lsp",
    "diagnostics",
    "tasks"
  ],
  "permissions": [
    "workspace_read",
    "process_spawn"
  ]
}
